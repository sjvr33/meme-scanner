{
  "id": "dune",
  "enabled": true,
  "mcp_server_name": "dune",
  "type": "primary",
  "chains": {
    "robinhood": {
      "queries_config": "chains/robinhood/config/query-ids.json",
      "sql_dir": "chains/robinhood/dune"
    },
    "solana": {
      "queries_config": "chains/solana/config/query-ids.json",
      "sql_dir": "chains/solana/dune"
    }
  },
  "execution": {
    "method": "executeQueryById",
    "performance": "medium"
  },
  "query_keys": ["discover", "reactivate", "flow", "reflex", "flash", "cohort", "watch"],
  "alpha_query": "reflex",
  "flash_query": "flash",
  "cohort_query": "cohort"
}
