{
  "name": "meme-scanner",
  "version": "2.1.0",
  "description": "Multi-chain meme scanner with Reflex Score (RX) microstructure alpha + pluggable connectors",
  "chains": ["robinhood", "solana"],
  "connectors": {
    "dune": {
      "enabled": true,
      "mcp_server_name": "dune",
      "priority": 1,
      "provides": ["discovery", "reactivation", "flow", "reflex", "watch"]
    },
    "coinglass": {
      "enabled": false,
      "priority": 2,
      "provides": ["perp_oi", "funding", "liquidations"],
      "notes": "Stub — enable when MCP/API wired. Boosts MES for tokens with CEX perps."
    }
  },
  "scoring": {
    "engine": "MES×RX",
    "mes_doc": "core/scoring/MES.md",
    "reflex_doc": "core/scoring/REFLEX.md",
    "edge_doc": "core/scoring/EDGE.md",
    "backtests": "docs/BACKTESTS.md"
  },
  "automations": {
    "daily_digest": {
      "cron_utc": "0 6 * * *",
      "prompt": "prompts/orchestrator-multichain.md"
    },
    "deep_analyst": {
      "cron_utc": "30 6 * * *",
      "prompt": "prompts/analyst.md"
    }
  }
}
