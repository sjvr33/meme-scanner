{
  "name": "meme-scanner",
  "version": "2.7.0",
  "description": "Hold the book. Don't get farmed. Satellite looks only.",
  "chains": ["robinhood", "solana"],
  "connectors": {
    "dune": {
      "enabled": true,
      "mcp_server_name": "dune",
      "priority": 1,
      "provides": ["discovery", "reactivation", "flow", "reflex", "flash", "cohort", "watch"]
    },
    "coinglass": {
      "enabled": false,
      "priority": 2,
      "provides": ["perp_oi", "funding", "liquidations"],
      "notes": "Stub — enable when MCP/API wired. Boosts MES for tokens with CEX perps."
    }
  },
  "scoring": {
    "engine": "BOOK + INTEGRITY + MES×RX + FLASH + COHORT + THESIS + AHEAD + TABLE",
    "book": "chains/robinhood/config/book.json",
    "ahead_doc": "core/scoring/AHEAD.md",
    "mes_doc": "core/scoring/MES.md",
    "reflex_doc": "core/scoring/REFLEX.md",
    "flash_doc": "core/scoring/FLASH.md",
    "integrity_doc": "core/scoring/INTEGRITY.md",
    "thesis_doc": "core/scoring/THESIS.md",
    "edge_doc": "core/scoring/EDGE.md",
    "table_doc": "core/scoring/TABLE.md",
    "backtests": "docs/BACKTESTS.md"
  },
  "automations": {
    "daily_digest": {
      "name": "Meme Scanner — Multi-Chain Reflex Digest",
      "cron_utc": "0 6 * * *",
      "cron_sast": "08:00",
      "prompt": "prompts/orchestrator-multichain.md",
      "prefill": "automation/scanner-multichain-prefill.json",
      "repo": "sjvr33/meme-scanner",
      "branch": "main"
    }
  }
}
